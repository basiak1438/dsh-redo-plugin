{
  "name": "dsh-redo-plugin",
  "version": "0.2.0",
  "description": "Standalone Redo: in-place prompt editing, workspace file restore, and auto-resend · 订正（独立版）：改写已提交提问、自动还原工作区文件并重新发送",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basiak1438/dsh-redo-plugin.git"
  },
  "homepage": "https://github.com/basiak1438/dsh-redo-plugin#readme",
  "bugs": {
    "url": "https://github.com/basiak1438/dsh-redo-plugin/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  }
}
