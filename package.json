{
  "name": "dsh-redo-plugin",
  "version": "0.1.0",
  "description": "Redo: edit a submitted prompt and resend it after rewinding · 订正：改掉已提交的提问并重发",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basiak1438/dsh-redo-plugin.git"
  },
  "homepage": "https://github.com/basiak1438/dsh-redo-plugin#readme",
  "bugs": {
    "url": "https://github.com/basiak1438/dsh-redo-plugin/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "dsh-rewind-plugin": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "dsh-rewind-plugin": {
      "optional": true
    }
  }
}
